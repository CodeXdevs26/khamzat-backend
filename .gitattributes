# Normalize line endings: store as LF in the repo and check out as LF on every OS,
# so Prettier/ESLint results are identical on Windows, macOS and Linux.
* text=auto eol=lf

# Windows-only scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.wav binary
